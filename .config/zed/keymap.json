[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-5": "pane::SplitRight",
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-l": "workspace::ActivatePaneRight",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-1": [
        "pane::ActivateItem",
        0
      ],
      "alt-2": [
        "pane::ActivateItem",
        1
      ],
      "alt-3": [
        "pane::ActivateItem",
        2
      ]
    }
  }
]
