{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "cyan",
      "2": "blue"
    }
  },
  "display": {
    "color": {
      "keys": "cyan",
      "title": "blue",
      "separator": "blue"
    },
    "percent": {
      "color": {
        "green": "blue",
        "yellow": "blue",
        "red": "blue"
      }
    }
  },
  "modules": [
    "title",
    "os",
    "kernel",
    "uptime",
    "packages",
    "memory",
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    }
  ]
}
